                    Computed
                </span>
            </div>

            <div class="result-grid">

                <div>
                    <small>Sample</small>
                    <strong>
                        ${escapeHTML(data.sample_id)}
                    </strong>
                </div>

                <div>
                    <small>Cancer Type</small>
